<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta Arcade (spec rodada 2, 4.1) -->
    <Color x:Key="BgColor">#1B1030</Color>
    <SolidColorBrush x:Key="Bg" Color="#1B1030" />
    <SolidColorBrush x:Key="Side" Color="#24143F" />
    <SolidColorBrush x:Key="TopBar" Color="#2A1748" />
    <SolidColorBrush x:Key="Card" Color="#2F1A52" />
    <SolidColorBrush x:Key="CardActive" Color="#4A2785" />
    <SolidColorBrush x:Key="Pill" Color="#3B2263" />
    <SolidColorBrush x:Key="Field" Color="#160C28" />
    <SolidColorBrush x:Key="Outline" Color="#120A22" />
    <SolidColorBrush x:Key="Purple" Color="#C45CFF" />
    <SolidColorBrush x:Key="Yellow" Color="#FFD25A" />
    <SolidColorBrush x:Key="YellowText" Color="#3B1D00" />
    <SolidColorBrush x:Key="Green" Color="#5CFF9D" />
    <SolidColorBrush x:Key="Orange" Color="#FF8A3D" />
    <SolidColorBrush x:Key="Text" Color="#F4ECFF" />
    <SolidColorBrush x:Key="Muted" Color="#C4B2E6" />
    <SolidColorBrush x:Key="Err" Color="#FF5C7A" />
    <SolidColorBrush x:Key="HoverGlow" Color="#14FFFFFF" />
    <LinearGradientBrush x:Key="RamGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5CFF9D" Offset="0" />
        <GradientStop Color="#FFD25A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CheckerA" Color="#27144A" />
    <SolidColorBrush x:Key="CheckerB" Color="#2D1850" />
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource CheckerA}" Geometry="M0,0 H2 V2 H0 Z" />
                <GeometryDrawing Brush="{StaticResource CheckerB}" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Paleta dos avatares (índice estável por conta) -->
    <x:Array x:Key="AvatarPalette" Type="SolidColorBrush">
        <SolidColorBrush Color="#FF8A3D" />
        <SolidColorBrush Color="#9B6BFF" />
        <SolidColorBrush Color="#5CFF9D" />
        <SolidColorBrush Color="#4CC9F0" />
        <SolidColorBrush Color="#FFD25A" />
        <SolidColorBrush Color="#FF6FB5" />
    </x:Array>

    <!-- Fontes embutidas (OFL) -->
    <FontFamily x:Key="PixelFont">pack://application:,,,/Resources/Fonts/#Press Start 2P</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Resources/Fonts/#Space Grotesk</FontFamily>

    <!-- Sem estilo implícito de TextBlock: no nível do App ele vence a cor dos botões (gotcha do WPF).
         Cor e fonte vêm por herança do estilo ArcadeWindow. -->
    <Style x:Key="PixelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="ArcadeWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Bg}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Botão "fofo": borda escura, sombra sólida de 3 px, afunda ao pressionar -->
    <Style x:Key="ArcadeButton" TargetType="ButtonBase">
        <Setter Property="Background" Value="{DynamicResource Pill}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Margin="0,0,0,3">
                        <Border CornerRadius="7" Background="{DynamicResource Outline}" Margin="0,3,0,-3" />
                        <Grid x:Name="Face">
                            <Border CornerRadius="7" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Outline}" BorderThickness="2" />
                            <Border x:Name="Glow" CornerRadius="7" Background="{DynamicResource HoverGlow}" Visibility="Collapsed" Margin="2" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ArcadeButton}" />
    <Style x:Key="ArcadePrimaryButton" TargetType="Button" BasedOn="{StaticResource ArcadeButton}">
        <Setter Property="Background" Value="{DynamicResource Yellow}" />
        <Setter Property="Foreground" Value="{DynamicResource YellowText}" />
    </Style>
    <Style x:Key="ArcadeSelectedButton" TargetType="Button" BasedOn="{StaticResource ArcadeButton}">
        <Setter Property="Background" Value="{DynamicResource Purple}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="ArcadeDangerButton" TargetType="Button" BasedOn="{StaticResource ArcadeButton}">
        <Setter Property="Background" Value="{DynamicResource Err}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Botão pequeno e sem moldura (ícones ✎ ⋯ ⌄ dentro dos cards) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverGlow}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Abas das contas -->
    <Style x:Key="ArcadeTab" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Outline}"
                            BorderThickness="2,2,2,0" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ArcadeTabSelected" TargetType="Button" BasedOn="{StaticResource ArcadeTab}">
        <Setter Property="Background" Value="{DynamicResource Purple}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Escolha em "pílula" (Senha / Google / Nenhum) -->
    <Style x:Key="ArcadeChoice" TargetType="RadioButton" BasedOn="{StaticResource ArcadeButton}">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Purple}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ArcadeCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Campos -->
    <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
        <Border x:Name="Bd" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Outline}" BorderThickness="2" CornerRadius="6">
            <ScrollViewer x:Name="PART_ContentHost" Margin="6,3" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Purple}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Yellow}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Purple}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Yellow}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Purple}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="{DynamicResource Field}"
                                BorderBrush="{DynamicResource Outline}" BorderThickness="2" VerticalAlignment="Center">
                            <TextBlock x:Name="Mark" Text="✓" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Bg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,-2,0,0" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Green}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de RAM -->
    <Style x:Key="RamBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{DynamicResource Outline}" CornerRadius="3">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource RamGradient}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus de contexto -->
    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Outline}" BorderThickness="2" CornerRadius="8" Padding="4">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Padding="12,6" CornerRadius="5" Background="Transparent">
                        <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardActive}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="2" Background="{DynamicResource Outline}" Margin="4,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Outline}" CornerRadius="6" Padding="8,5">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de rolagem fina -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Pill}" CornerRadius="4" Margin="1,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<Window x:Class="IdleDeck.App.Modules.ModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Módulo" Width="1220" Height="800" MinWidth="820" MinHeight="480"
        Icon="/Resources/AppIcon.ico"
        Style="{StaticResource ArcadeWindow}" ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner">
    <!-- Sem a barra do Windows (nada de — □ X do sistema): a moldura, o — e o ✕ são os do app. Tem botão próprio na barra de
         tarefas: minimizar esta janela não mexe na principal (minimizar a principal manda o app para a bandeja).
         O WindowChrome devolve a borda de redimensionar/snap, que o WindowStyle=None remove. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Outline}" BorderThickness="3">
        <DockPanel>
            <!-- Cabeçalho do popup: arrasta a janela e fecha no ✕ -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource TopBar}" BorderBrush="{DynamicResource Outline}"
                    BorderThickness="0,0,0,3" Padding="14,12,10,12" MouseLeftButtonDown="Header_MouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" FontSize="15"
                            Click="Close_Click" ToolTip="Fechar (Esc)" VerticalAlignment="Top" />
                    <Button DockPanel.Dock="Right" Content="—" Style="{StaticResource IconButton}" FontSize="15"
                            Click="Minimize_Click" ToolTip="Minimizar só esta janela" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Style="{StaticResource PixelTitle}" FontSize="11"
                                   Foreground="{DynamicResource Text}" />
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Muted}" FontSize="12"
                                   Margin="0,7,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Conteúdo: o painel do módulo (um só por módulo, reaproveitado ao reabrir) -->
            <Border x:Name="Body" Padding="14,12,14,14" Background="{DynamicResource Bg}" />
        </DockPanel>
    </Border>
</Window>

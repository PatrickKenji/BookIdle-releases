<Window x:Class="IdleDeck.App.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:IdleDeck.App.Localization"
        Title="{l:T 'Destravar cofre'}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource ArcadeWindow}" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="{l:T 'SENHA MESTRA DO COFRE'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <TextBlock x:Name="Hint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                   Text="{l:T 'Necessária para o login automático das contas.'}" />
        <PasswordBox x:Name="Password" KeyDown="Password_KeyDown" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Err}" Margin="0,6,0,0" Visibility="Collapsed"
                   Text="{l:T 'Senha incorreta ou cofre corrompido.'}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SkipButton" Content="{l:T 'Pular'}" Click="Skip_Click"
                    ToolTip="{l:T 'Abre o app sem login automático'}" />
            <Button Content="{l:T 'Destravar'}" Click="Unlock_Click" Style="{StaticResource ArcadeSelectedButton}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>

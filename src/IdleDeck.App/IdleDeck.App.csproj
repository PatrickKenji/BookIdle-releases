<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BookIdle</AssemblyName>
    <Product>BookIdle</Product>
    <AssemblyTitle>BookIdle</AssemblyTitle>
    <Company>BookIdle</Company>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <!-- Versão do app (o script de lançamento troca por -p:Version=x.y.z); aparece na bandeja e decide as atualizações. -->
    <Version>1.0.0</Version>
    <!-- O Velopack precisa rodar no começo do Main: o App ganha um Main próprio (App.xaml.cs). -->
    <StartupObject>IdleDeck.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="IdleDeck.Core.Localization" />
    <EmbeddedResource Include="Scripts\login-detect.js" LogicalName="Scripts.login-detect.js" />
    <EmbeddedResource Include="Scripts\topidle-vote.js" LogicalName="Scripts.topidle-vote.js" />
    <EmbeddedResource Include="Scripts\topidle-status.js" LogicalName="Scripts.topidle-status.js" />
    <EmbeddedResource Include="Scripts\market-probe.js" LogicalName="Scripts.market-probe.js" />
    <EmbeddedResource Include="Scripts\market-bridge.js" LogicalName="Scripts.market-bridge.js" />
    <EmbeddedResource Include="Modules\Hunt\*.js" LogicalName="Modules.Hunt.%(Filename)%(Extension)" />
    <Resource Include="Resources\Fonts\*.ttf" />
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\*.png" />
    <None Include="Resources\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdleDeck.Core\IdleDeck.Core.csproj" />
  </ItemGroup>

</Project>

<Window x:Class="IdleDeck.App.ArcadeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:IdleDeck.App.Localization"
        Style="{StaticResource ArcadeWindow}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <DockPanel>
            <TextBlock x:Name="KindIcon" DockPanel.Dock="Left" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PixelTitle}" TextWrapping="Wrap" LineHeight="16" />
                <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="19" />
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="NoButton" Content="{l:T 'Não'}" Click="No_Click" IsCancel="True" Visibility="Collapsed" />
            <Button x:Name="YesButton" Content="{l:T 'OK'}" Click="Yes_Click" IsDefault="True" Style="{StaticResource ArcadePrimaryButton}" MinWidth="70" />
        </StackPanel>
    </StackPanel>
</Window>
